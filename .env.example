# ---- Backend (read by pydantic-settings with the QUIVER_ prefix) ----
QUIVER_MONGO_URL=mongodb://localhost:27017
QUIVER_MONGO_DB=quiver
# Signs JWTs. Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
QUIVER_SECRET_KEY=change-me-in-production
# Encrypts upstream credentials at rest. Falls back to the secret key when empty.
QUIVER_ENCRYPTION_KEY=
QUIVER_ALLOWED_ORIGINS=http://localhost:5182
QUIVER_FRONTEND_URL=http://localhost:5182
QUIVER_PUBLIC_API_URL=http://localhost:8010
QUIVER_PROBE_INTERVAL_S=300

# ---- Frontend (Vite, baked in at build time) ----
# Leave unset to run the frontend in demo mode without a backend.
VITE_API_URL=http://localhost:8010
